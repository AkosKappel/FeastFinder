{
  "ci": {
    "collect": {
      "startServerCommand": "node test/e2e/server.mjs",
      "startServerReadyPattern": "Serving",
      "url": [
        "http://localhost:4173/FeastFinder/",
        "http://localhost:4173/FeastFinder/meals/52772/",
        "http://localhost:4173/FeastFinder/categories/",
        "http://localhost:4173/FeastFinder/fridge/",
        "http://localhost:4173/FeastFinder/about/"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.75 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-report" }
  }
}
